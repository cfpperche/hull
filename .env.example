# Single config surface. Copy to .env — scripts do the rest.
# Values are the white-label. The HULL_ prefix is the scaffold, not the product name.
HULL_HOST=hull.test
HULL_BRAND=Hull
HULL_MARK=H
HULL_COOKIE_NAME=hull_session
HULL_BIND=127.0.0.1
HULL_POSTGRES_USER=hull
HULL_POSTGRES_PASSWORD=hull
HULL_POSTGRES_DB=hull
HULL_PG_PORT=5432
HULL_SEED_DEMO=1
HULL_S3_ACCESS_KEY=hull-s3
HULL_S3_SECRET_KEY=hull-s3-lab-secret
# Empty MAIL_FROM → "{brand} <noreply@{host}>"
HULL_MAIL_FROM=
# dbgate at db.<host> — a lab service like Mailpit. It is a SQL console on the
# live database, so it always requires these credentials. Change them for any
# install that is not a throwaway lab.
HULL_DBGATE_USER=hull
HULL_DBGATE_PASSWORD=hull-studio-lab-secret
