.env
# Every dotenv variant, not just the bare file — .env.local and .env.<mode> are
# what Vite auto-loads, and this is a public repo.
.env.*
!.env.example
node_modules/
dist/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
.turbo/
.pnpm-store/
deploy/certs/**
!deploy/certs/.gitkeep
!deploy/certs/ca/.gitkeep
deploy/traefik/dynamic.yml
deploy/coredns/Corefile
deploy/brand/config.json
apps/*/public/config.json
*.pem
*.key
.DS_Store
e2e/test-results/
e2e/playwright-report/
e2e/blob-report/
coverage/
htmlcov/
uv.lock.bak
*.log
.idea/
.vscode/
harness/visual/current/
harness/visual/evidence/
harness/qa/runs/
# Peer exchanges: what we asked another agent, what it answered, what it cost.
# Worth keeping for the length of a task, not the length of the repo — a finding
# that matters becomes a test, an ADR, or a line in CHANGELOG.md.
harness/peer/exchanges/
harness/peer/worktrees/
harness/peer/schemas/
# Design harness runs: screenshots, measured facts, what each critic answered.
# Evidence for the length of a task, not the length of the repo — a finding that
# should outlive the run becomes a budget in design.config.json, a test, or a
# line in CHANGELOG.md. The profile itself is tracked; the runs are not.
.design/runs/
