tls:
  certificates:
    - certFile: /etc/traefik/certs/hull-cert.pem
      keyFile: /etc/traefik/certs/hull-key.pem

http:
  middlewares:
    strip-api:
      stripPrefix:
        prefixes:
          - "/api"
    api-headers:
      headers:
        customResponseHeaders:
          Cache-Control: "no-store"
        customRequestHeaders:
          X-Forwarded-Prefix: "/api"
    # Same limits and the same split as prod on purpose. A dev edge that behaves
    # differently from the real one is where rate-limit surprises come from.
    auth-ratelimit:
      rateLimit:
        average: 10
        period: 1m
        burst: 20
    signup-ratelimit:
      rateLimit:
        average: 30
        period: 1m
        burst: 60

  routers:
    hull-www:
      rule: "Host(`__HOST__`) || Host(`www.__HOST__`)"
      entryPoints: [websecure]
      service: hull-www
      priority: 1
      tls: {}
    hull-web-auth:
      rule: "Host(`app.__HOST__`) && (Path(`/api/v1/auth/signin`) || Path(`/api/v1/auth/reset`) || Path(`/api/v1/me/password`) || Path(`/api/v1/session/handoff`))"
      entryPoints: [websecure]
      middlewares: [auth-ratelimit, strip-api, api-headers]
      service: hull-api
      priority: 200
      tls: {}
    hull-web-signup:
      rule: "Host(`app.__HOST__`) && (Path(`/api/v1/auth/signup`) || Path(`/api/v1/auth/forgot`))"
      entryPoints: [websecure]
      middlewares: [signup-ratelimit, strip-api, api-headers]
      service: hull-api
      priority: 200
      tls: {}
    hull-web-api:
      rule: "Host(`app.__HOST__`) && PathPrefix(`/api`)"
      entryPoints: [websecure]
      middlewares: [strip-api, api-headers]
      service: hull-api
      priority: 100
      tls: {}
    hull-web:
      rule: "Host(`app.__HOST__`)"
      entryPoints: [websecure]
      service: hull-web
      priority: 1
      tls: {}
    hull-admin-auth:
      rule: "Host(`admin.__HOST__`) && (Path(`/api/v1/auth/signin`) || Path(`/api/v1/auth/reset`) || Path(`/api/v1/me/password`) || Path(`/api/v1/session/handoff`))"
      entryPoints: [websecure]
      middlewares: [auth-ratelimit, strip-api, api-headers]
      service: hull-api
      priority: 200
      tls: {}
    hull-admin-signup:
      rule: "Host(`admin.__HOST__`) && (Path(`/api/v1/auth/signup`) || Path(`/api/v1/auth/forgot`))"
      entryPoints: [websecure]
      middlewares: [signup-ratelimit, strip-api, api-headers]
      service: hull-api
      priority: 200
      tls: {}
    hull-admin-api:
      rule: "Host(`admin.__HOST__`) && PathPrefix(`/api`)"
      entryPoints: [websecure]
      middlewares: [strip-api, api-headers]
      service: hull-api
      priority: 100
      tls: {}
    hull-admin:
      rule: "Host(`admin.__HOST__`)"
      entryPoints: [websecure]
      service: hull-admin
      priority: 1
      tls: {}
    hull-mail:
      rule: "Host(`mail.__HOST__`)"
      entryPoints: [websecure]
      service: hull-mailpit
      priority: 1
      tls: {}
    hull-s3:
      rule: "Host(`s3.__HOST__`)"
      entryPoints: [websecure]
      service: hull-s3
      priority: 1
      tls: {}
    hull-rustfs:
      rule: "Host(`rustfs.__HOST__`)"
      entryPoints: [websecure]
      service: hull-rustfs
      priority: 1
      tls: {}

  services:
    hull-api:
      loadBalancer:
        servers:
          - url: "http://host.docker.internal:8080"
        passHostHeader: true
    hull-www:
      loadBalancer:
        servers:
          - url: "http://host.docker.internal:5175"
        passHostHeader: true
    hull-web:
      loadBalancer:
        servers:
          - url: "http://host.docker.internal:5173"
        passHostHeader: true
    hull-admin:
      loadBalancer:
        servers:
          - url: "http://host.docker.internal:5174"
        passHostHeader: true
    hull-mailpit:
      loadBalancer:
        servers:
          - url: "http://mailpit:8025"
        passHostHeader: true
    hull-s3:
      loadBalancer:
        servers:
          - url: "http://rustfs:9000"
        passHostHeader: true
    hull-rustfs:
      loadBalancer:
        servers:
          - url: "http://rustfs:9001"
        passHostHeader: true
