tls:
  certificates:
    - certFile: /etc/traefik/certs/hull-cert.pem
      keyFile: /etc/traefik/certs/hull-key.pem

http:
  middlewares:
    strip-api:
      stripPrefix:
        prefixes:
          - "/api"
    api-headers:
      headers:
        customResponseHeaders:
          Cache-Control: "no-store"
        customRequestHeaders:
          X-Forwarded-Prefix: "/api"

    # Credential endpoints only. AGENTS.md forbids adding Redis, so the counter
    # lives in Traefik's memory — no new service. Default sourceCriterion is the
    # client IP. Generous for a lab, useless for a password spray.
    auth-ratelimit:
      rateLimit:
        average: 10
        period: 1m
        burst: 20

  routers:
    hull-www:
      rule: "Host(`__HOST__`) || Host(`www.__HOST__`)"
      entryPoints: [websecure]
      service: hull-www
      priority: 1
      tls: {}

    # Priority 200, above the catch-all /api routers at 100, so the rate limit
    # applies before the general API route matches.
    hull-web-auth:
      rule: "Host(`app.__HOST__`) && (PathPrefix(`/api/v1/auth/`) || Path(`/api/v1/me/password`) || Path(`/api/v1/session/handoff`))"
      entryPoints: [websecure]
      middlewares: [auth-ratelimit, strip-api, api-headers]
      service: hull-api
      priority: 200
      tls: {}

    hull-web-api:
      rule: "Host(`app.__HOST__`) && PathPrefix(`/api`)"
      entryPoints: [websecure]
      middlewares: [strip-api, api-headers]
      service: hull-api
      priority: 100
      tls: {}

    hull-web:
      rule: "Host(`app.__HOST__`)"
      entryPoints: [websecure]
      service: hull-web
      priority: 1
      tls: {}

    hull-admin-auth:
      rule: "Host(`admin.__HOST__`) && (PathPrefix(`/api/v1/auth/`) || Path(`/api/v1/me/password`) || Path(`/api/v1/session/handoff`))"
      entryPoints: [websecure]
      middlewares: [auth-ratelimit, strip-api, api-headers]
      service: hull-api
      priority: 200
      tls: {}

    hull-admin-api:
      rule: "Host(`admin.__HOST__`) && PathPrefix(`/api`)"
      entryPoints: [websecure]
      middlewares: [strip-api, api-headers]
      service: hull-api
      priority: 100
      tls: {}

    hull-admin:
      rule: "Host(`admin.__HOST__`)"
      entryPoints: [websecure]
      service: hull-admin
      priority: 1
      tls: {}

    hull-mail:
      rule: "Host(`mail.__HOST__`)"
      entryPoints: [websecure]
      service: hull-mailpit
      priority: 1
      tls: {}

    hull-s3:
      rule: "Host(`s3.__HOST__`)"
      entryPoints: [websecure]
      service: hull-s3
      priority: 1
      tls: {}

    hull-rustfs:
      rule: "Host(`rustfs.__HOST__`)"
      entryPoints: [websecure]
      service: hull-rustfs
      priority: 1
      tls: {}

    hull-db:
      rule: "Host(`db.__HOST__`)"
      entryPoints: [websecure]
      service: hull-dbgate
      priority: 1
      tls: {}

  services:
    hull-api:
      loadBalancer:
        servers:
          - url: "http://api:8080"
        passHostHeader: true
    hull-www:
      loadBalancer:
        servers:
          - url: "http://www:80"
        passHostHeader: true
    hull-web:
      loadBalancer:
        servers:
          - url: "http://web:80"
        passHostHeader: true
    hull-admin:
      loadBalancer:
        servers:
          - url: "http://admin:80"
        passHostHeader: true
    hull-mailpit:
      loadBalancer:
        servers:
          - url: "http://mailpit:8025"
        passHostHeader: true
    hull-s3:
      loadBalancer:
        servers:
          - url: "http://rustfs:9000"
        passHostHeader: true
    hull-rustfs:
      loadBalancer:
        servers:
          - url: "http://rustfs:9001"
        passHostHeader: true
    hull-dbgate:
      loadBalancer:
        servers:
          - url: "http://dbgate:3000"
        passHostHeader: true
